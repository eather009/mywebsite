# HTTPS vhost — reference after certbot
# Certbot creates /etc/httpd/conf.d/eatherahmed-le-ssl.conf
# If https:// shows 503 but http:// works, your SSL vhost is missing the proxy block below.

<VirtualHost *:443>
    ServerName eatherahmed.com
    ServerAlias www.eatherahmed.com

    SSLEngine on
    SSLCertificateFile /etc/letsencrypt/live/eatherahmed.com/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/eatherahmed.com/privkey.pem
    Include /etc/letsencrypt/options-ssl-apache.conf

    Alias /uploads /var/www/eatherahmed/public/uploads
    <Directory /var/www/eatherahmed/public/uploads>
        Require all granted
        Options -Indexes
    </Directory>

    ProxyPreserveHost On
    ProxyRequests Off
    ProxyPass /uploads !
    ProxyPass / http://127.0.0.1:3000/
    ProxyPassReverse / http://127.0.0.1:3000/

    RequestHeader set X-Forwarded-Proto "https"
    RequestHeader set X-Forwarded-Port "443"

    ErrorLog /var/log/httpd/eatherahmed-ssl-error.log
    CustomLog /var/log/httpd/eatherahmed-ssl-access.log combined
</VirtualHost>
