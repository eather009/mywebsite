NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1

# Lightsail managed MySQL — replace with values from Lightsail console
DATABASE_URL="mysql://dbmasteruser:CHANGE_ME@YOUR_DB.us-east-1.rds.amazonaws.com:3306/portfolio"

# Generate with: openssl rand -base64 48
JWT_SECRET="change-this-to-a-long-random-secret-in-production"

# Used only on first `npm run db:seed` — change password in Admin → Account after login
ADMIN_EMAIL="admin@eatherahmed.com"
ADMIN_PASSWORD="change-me-on-first-login"
