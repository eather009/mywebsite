{
  "name": "myprotfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "npx prisma generate && npx prisma migrate deploy && npx tsx prisma/seed.ts && next build",
    "build:prod": "npx prisma generate && next build",
    "build:prod:lowmem": "NODE_OPTIONS='--max-old-space-size=512' npx prisma generate && NODE_OPTIONS='--max-old-space-size=512' next build",
    "build:static": "STATIC_SITE=1 next build",
    "build:static:lowmem": "NODE_OPTIONS='--max-old-space-size=512' STATIC_SITE=1 next build",
    "sync:standalone": "bash scripts/sync-public.sh && cp -r .next/static .next/standalone/.next/static && cp .env .next/standalone/.env && bash scripts/ensure-uploads-dir.sh",
    "deploy:prod": "npm run build:prod && npm run sync:standalone",
    "deploy:prod:lowmem": "npm run build:prod:lowmem && npm run sync:standalone",
    "deploy:static": "npm run build:static && npm run sync:standalone",
    "deploy:static:lowmem": "npm run build:static:lowmem && npm run sync:standalone",
    "start": "next start",
    "start:prod": "node .next/standalone/server.js",
    "lint": "eslint",
    "db:migrate": "npx prisma migrate dev",
    "db:deploy": "npx prisma migrate deploy",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:studio": "npx prisma studio",
    "db:up": "docker compose up -d mysql",
    "db:setup": "docker compose up -d mysql && npx prisma migrate deploy && npx tsx prisma/seed.ts",
    "postinstall": "npx prisma generate"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@tiptap/extension-character-count": "^3.24.0",
    "@tiptap/extension-code-block-lowlight": "^3.24.0",
    "@tiptap/extension-highlight": "^3.24.0",
    "@tiptap/extension-image": "^3.24.0",
    "@tiptap/extension-link": "^3.24.0",
    "@tiptap/extension-placeholder": "^3.24.0",
    "@tiptap/extension-table": "^3.24.0",
    "@tiptap/extension-table-cell": "^3.24.0",
    "@tiptap/extension-table-header": "^3.24.0",
    "@tiptap/extension-table-row": "^3.24.0",
    "@tiptap/extension-text-align": "^3.24.0",
    "@tiptap/extension-underline": "^3.24.0",
    "@tiptap/html": "^3.24.0",
    "@tiptap/pm": "^3.24.0",
    "@tiptap/react": "^3.24.0",
    "@tiptap/starter-kit": "^3.24.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "gray-matter": "^4.0.3",
    "happy-dom": "^20.10.6",
    "jose": "^6.2.3",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.17.0",
    "next": "16.2.6",
    "next-mdx-remote": "^6.0.0",
    "prisma": "5.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "reading-time": "^1.5.0",
    "slugify": "^1.6.9",
    "tsx": "^4.22.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
